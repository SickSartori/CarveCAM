{
  // Prova online di CarveCAM in GitHub Codespaces: compila il programma, lo avvia e apre la scheda del browser.
  // Serve solo per provarlo: il codespace si spegne dopo un po' di inattività e i progetti vanno salvati sul proprio PC.
  "name": "CarveCAM (prova online)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  // modalità demo: si apre sul progetto di esempio e restano spenti apertura, importazione e salvataggio
  "containerEnv": { "Demo__Enabled": "true" },
  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": { "label": "CarveCAM", "onAutoForward": "openBrowser" }
  },
  // compilato una volta alla creazione, in Release (il motore di calcolo è molto più veloce che in Debug)
  "postCreateCommand": "dotnet build src/CarveCAM.Server/CarveCAM.Server.vbproj -c Release",
  // a ogni collegamento avvia il server, ma solo se non risponde già (Codespaces può collegarsi più volte: una seconda copia
  // darebbe "address already in use"); la porta 5080 è quella di appsettings.json
  "postAttachCommand": {
    "CarveCAM": "if curl -fs -o /dev/null http://localhost:5080/api/version; then echo 'CarveCAM è già in esecuzione: apri la porta 5080 dalla scheda Porte.'; else dotnet run -c Release --no-build --no-launch-profile --project src/CarveCAM.Server/CarveCAM.Server.vbproj; fi"
  }
}
